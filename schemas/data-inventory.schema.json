{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akb.studio/schemas/production-website/data-inventory.schema.json",
  "title": "Production Website data inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fictional", "product", "reviewed_at", "records"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "fictional": { "type": "boolean" },
    "product": { "type": "string", "minLength": 3 },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "data_category", "source", "purpose", "legal_basis_or_ground", "system", "region", "classification", "access", "recipients", "retention", "deletion_proof", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^DATA-[0-9]{3,}$" },
          "data_category": { "type": "string", "minLength": 3 },
          "source": { "type": "string", "minLength": 3 },
          "purpose": { "type": "string", "minLength": 5 },
          "legal_basis_or_ground": { "type": "string", "minLength": 3 },
          "system": { "type": "string", "minLength": 3 },
          "region": { "type": "string", "minLength": 2 },
          "classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "access": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "recipients": { "type": "array", "items": { "type": "string" } },
          "retention": { "type": "string", "minLength": 5 },
          "deletion_proof": { "type": "string", "minLength": 5 },
          "owner": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}

