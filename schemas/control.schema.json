{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akb.studio/schemas/production-website/control.schema.json",
  "title": "Production Website control catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_version", "book_edition", "controls"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "repository_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "book_edition": { "type": "string", "const": "1.0" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirement_level", "scope", "requirement", "rationale", "implementation_evidence", "tests", "owner", "exception", "source_reference"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,31}$" },
          "title": { "type": "string", "minLength": 4 },
          "requirement_level": { "type": "string", "enum": ["MUST", "SHOULD", "MAY"] },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["book", "design", "content", "component", "page", "client", "server", "api", "realtime", "data", "privacy", "security", "payment", "testing", "release", "operations", "agent", "repository"] }
          },
          "requirement": { "type": "string", "minLength": 20 },
          "rationale": { "type": "string", "minLength": 20 },
          "implementation_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "owner": { "type": "string", "minLength": 3 },
          "exception": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "conditions", "expiry_required", "approval_required"],
            "properties": {
              "allowed": { "type": "boolean" },
              "conditions": { "type": "string" },
              "expiry_required": { "type": "boolean" },
              "approval_required": { "type": "string", "minLength": 3 }
            }
          },
          "source_reference": { "type": "string", "pattern": "^(Chapters?|Section|Appendix) [A-Z0-9.-]+" }
        }
      }
    }
  }
}
